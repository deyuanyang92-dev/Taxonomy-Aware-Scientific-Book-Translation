   "level": null,
   "bbox_pt": [
    60.6,
    397.3,
    305.7,
    419.3
   ],
   "bbox_rel": [
    0.09731,
    0.50684,
    0.49106,
    0.5349
   ],
   "text": "anal plaque: depressed (or sunken) plate-like pygidium of some *Maldanidae* and other annelids.",
