   "role": "entry",
   "level": null,
   "bbox_pt": [
    60.6,
    328.4,
    305.6,
    350.4
   ],
   "bbox_rel": [
    0.09731,
    0.41886,
    0.49104,
    0.44693
   ],
   "text": "adelphophagy: consumption by a developing larva of nurse eggs present in the same egg capsule.",
   "italic_words": [],
   "col": 0,
   "order": 5,
   "bbox_scan_rel": [
    0.03555,
    0.41031,
    0.44955,
    0.44205
   ]
  },
